-- Run once in the hosted Supabase SQL editor after deploying diary-worker.
-- Replace both placeholders. Vault stores the values encrypted; do not commit
-- production values to this file.

select vault.create_secret(
  'https://YOUR_PROJECT_REF.supabase.co/functions/v1/diary-worker',
  'diary_worker_url'
);
select vault.create_secret(
  'YOUR_DIARY_WORKER_SECRET',
  'diary_worker_secret'
);

select cron.schedule(
  'drain-diary-jobs',
  '* * * * *',
  $$
  select net.http_post(
    url := (
      select decrypted_secret
      from vault.decrypted_secrets
      where name = 'diary_worker_url'
    ),
    headers := jsonb_build_object(
      'Content-Type', 'application/json',
      'x-diary-worker-secret', (
        select decrypted_secret
        from vault.decrypted_secrets
        where name = 'diary_worker_secret'
      )
    ),
    body := '{"source":"cron"}'::jsonb
  );
  $$
);
