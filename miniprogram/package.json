{
  "name": "@possibility/miniprogram",
  "version": "0.1.0",
  "private": true,
  "description": "万花筒 · 微信小程序端",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "eslint \"src/**/*.ts\"",
    "lint:tokens": "node scripts/check-design-tokens.mjs",
    "size": "node scripts/check-package-size.mjs",
    "structure": "node scripts/check-structure.mjs",
    "check": "npm run typecheck && npm run structure && npm run lint:tokens && npm run size"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "eslint": "^9.17.0",
    "miniprogram-api-typings": "^4.0.7",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.18.0"
  }
}
