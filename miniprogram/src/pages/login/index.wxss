@import '../../core/design/tokens.wxss';

.page {
  min-height: 100vh;
  /* padding-top 归 .safe-top 管，不能写 padding 简写（见 app.wxss）*/
  padding-left: 48rpx;
  padding-right: 48rpx;
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
}

.hero {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 24rpx;
}

.hero__title {
  font-size: 52rpx;
  font-weight: 600;
  color: var(--ink);
  letter-spacing: 4rpx;
}

.hero__sub {
  font-size: 26rpx;
  color: var(--sub);
  text-align: center;
  line-height: 1.7;
}

.actions {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 20rpx;
  /* 底部留白走 margin：padding-bottom 归 .safe-bottom 管（见 app.wxss）*/
  margin-bottom: 64rpx;
}

.actions__error {
  font-size: 24rpx;
  color: var(--orange);
}

.actions__terms {
  font-size: 22rpx;
  color: var(--faint);
}
