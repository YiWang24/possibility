@import '../../core/design/tokens.wxss';

.page {
  min-height: 100vh;
  padding: 0 48rpx;
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
}

.hero {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 24rpx;
}

.hero__title {
  font-size: 52rpx;
  font-weight: 600;
  color: var(--ink);
  letter-spacing: 4rpx;
}

.hero__sub {
  font-size: 26rpx;
  color: var(--sub);
  text-align: center;
  line-height: 1.7;
}

.actions {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 20rpx;
  padding-bottom: 80rpx;
}

.actions__error {
  font-size: 24rpx;
  color: var(--orange);
}

.actions__terms {
  font-size: 22rpx;
  color: var(--faint);
}
