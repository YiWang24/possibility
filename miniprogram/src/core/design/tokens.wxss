/**
 * 设计系统 · 色板与渐变
 *
 * 唯一事实来源是 iOS 的 `ios/Possibility/Core/DesignSystem/Theme.swift`，
 * 它本身又与原型 CSS 的 `:root` 变量一一对应 —— 所以这里是「回到 CSS」，
 * 变量名与原型保持一致，改色只改这一个文件。
 *
 * ⚠️ 页面/组件的 wxss 里禁止写死颜色（十六进制或 rgba），一律从这里取。
 * `npm run lint:tokens` 会拦（对应 web 的 `web/scripts/check-design-tokens.mjs`）。
 * 只管颜色：字号与圆角在 iOS 那边本来就是各视图内联的数字（Theme.swift 里没有字阶），
 * 这里跟着走，不另造一套基准里不存在的体系。
 */

page,
.kaleido-root {
  /* ── 基础色（Theme.stage / paper / card / raised / ink / sub / faint / line）── */
  --stage: #05070d;
  --paper: #0a0c12;
  --card: #13161f;
  --raised: #1b1f2b;
  --ink: #f2f4f9;
  --sub: #98a0b3;
  --faint: #5a6172;
  --line: rgba(255, 255, 255, 0.08);

  /* ── 品牌色 ── */
  --blue: #5e96ff;
  --blue-deep: #2f63e8;
  --violet-soft: #8f7bff;
  --pink: #f06acd;
  --magenta: #e35cc1;
  --orange: #ff7a4d;
  --apricot: #ffb067;
  --teal: #3ed9a4;
  --lime: #d7f464;

  /* ── 渐变 ── */
  /* 极光渐变（Theme.aurora） */
  --aurora: linear-gradient(
    135deg,
    #5e96ff 0%,
    #8f7bff 40%,
    #e35cc1 75%,
    #ff7a4d 100%
  );
  /* 极光渐变 · 深（Theme.auroraDeep） */
  --aurora-deep: linear-gradient(
    135deg,
    #2f63e8 0%,
    #b03390 60%,
    #e8542f 100%
  );
  /* 主按钮渐变（Theme.buttonGradient） */
  --btn-g: linear-gradient(135deg, #6fa5ff, #2f63e8);

  /* 光球 / 万花筒的 conic 色环（Theme.orbConicColors）。
     ⚠️ Skyline 对 conic-gradient 的支持需由 W0-0 冒烟验证确认；
     不支持时 OrbView 退回 canvas 2d 绘制，本变量仍作为色标来源。 */
  --orb-conic: conic-gradient(
    from 0deg,
    #5e96ff 0%,
    #8f7bff 25%,
    #e35cc1 50%,
    #ff7a4d 75%,
    #5e96ff 100%
  );

  /* ── 旅人头像配色（Theme.hues，原型 HUES 0..4）── */
  --hue0-g: linear-gradient(135deg, #0f1f52 0%, #2e5edb 55%, #6fa5ff 100%);
  --hue0-accent: #3d6ef0;
  --hue1-g: linear-gradient(135deg, #3a1035 0%, #b03390 55%, #f06acd 100%);
  --hue1-accent: #c445a4;
  --hue2-g: linear-gradient(135deg, #0e2a22 0%, #1f8a66 60%, #8fd84b 100%);
  --hue2-accent: #2fa98c;
  --hue3-g: linear-gradient(135deg, #3a140c 0%, #d14a24 60%, #ff8a54 100%);
  --hue3-accent: #e85a34;
  --hue4-g: linear-gradient(135deg, #171243 0%, #4a3bd1 60%, #8f7bff 100%);
  --hue4-accent: #6e58e8;

  /* ── 卡面点缀色（Theme.cardAccents）──
     LLM 返回的颜色只当色相提示，一律吸附到这五档，否则一屏卡片会出现
     互不相干的随机彩虹色 —— 那正是「模型生成感」的来源之一。 */
  --accent-0: #5e96ff;
  --accent-1: #8f7bff;
  --accent-2: #e35cc1;
  --accent-3: #ffb067;
  --accent-4: #3ed9a4;

  /* ── 圆角（Theme.Radius）── */
  --r-card: 22rpx;
  --r-sheet: 30rpx;
  --r-chip: 999rpx;

  /* ── 品牌色的透明档与浅色梯度 ──
     iOS 各 Feature 里 `Color(hex: 0x6FA5FF, alpha:)` 出现 25 次、
     `.white.opacity(0.045)` 5 次 —— 是复用的设计语言而非某个页面的私料，
     所以收在这里。页面需要「品牌色带透明」时一律从这取，不要自己写 rgba。 */
  --blue-line: rgba(111, 165, 255, 0.34); /* 强调描边（主路径卡 / 重试胶囊）*/
  --blue-line-soft: rgba(111, 165, 255, 0.2); /* 面板描边 */
  --blue-wash: rgba(94, 150, 255, 0.1); /* 极淡底色（重试胶囊）*/
  --surface-ghost: rgba(255, 255, 255, 0.045); /* 次级路径卡底 */
  /* 浅色梯度：eyebrow → 链接 → 卡内标签，越大越浅 */
  --blue-100: #91b1ff;
  --blue-200: #9dbcff;
  --blue-300: #afc7ff;
  --blue-400: #b8cdff;

  /* ── 强调卡描边（三色同为 alpha 0.25，用色相区分卡片语义）── */
  --line-accent-blue: rgba(111, 165, 255, 0.25); /* hero 卡 */
  --line-accent-violet: rgba(169, 125, 255, 0.25); /* 「两股拉力」*/
  --line-accent-teal: rgba(62, 217, 164, 0.25); /* 「下一步的小验证」*/

  /* 长正文：比 --sub 亮、比 --ink 暗，用于需要连读数行的卡片正文 */
  --body-dim: #c6cdde;
  /* 渐变底/实色按钮上的文字（iOS 直接写 Color.white）*/
  --on-accent: #ffffff;
  /* 半透明白：spinner 轨道等「比 --line 明显、但仍是白纱」的地方 */
  --track: rgba(255, 255, 255, 0.3);
  /* 弹层遮罩（--stage 的 0.72）*/
  --scrim: rgba(5, 7, 13, 0.72);

  /* 品牌染色渐变（面板 / 主路径 / hero 卡） */
  --tint-panel: linear-gradient(
    135deg,
    rgba(94, 150, 255, 0.11) 0%,
    rgba(143, 123, 255, 0.055) 100%
  );
  --tint-primary: linear-gradient(
    135deg,
    rgba(62, 112, 232, 0.28) 0%,
    rgba(107, 85, 211, 0.18) 100%
  );
  --tint-hero: linear-gradient(
    135deg,
    rgba(64, 101, 203, 0.24) 0%,
    rgba(113, 73, 170, 0.12) 100%
  );
  /* 用户气泡（ChatView.bubbleBackground） */
  --user-bubble: linear-gradient(135deg, #3e77f2 0%, #2a50d6 100%);

  /* ── 阴影（CardBackground）── */
  --shadow-card: 0 2rpx 8rpx rgba(0, 0, 0, 0.55);
}

/* ── 通用卡片样式（对应 iOS 的 .kaleidoCard() modifier）── */
.kaleido-card {
  background: var(--card);
  border-radius: var(--r-card);
  border: 1rpx solid var(--line);
  box-shadow: var(--shadow-card);
  overflow: hidden;
}

/* ── 标签胶囊（对应 iOS TagPill）── */
.tag-pill {
  display: inline-flex;
  align-items: center;
  padding: 4rpx 16rpx;
  border-radius: var(--r-chip);
  background: var(--raised);
  border: 1rpx solid var(--line);
  color: var(--sub);
  font-size: 20rpx;
}
