/**
 * 设计系统 · 色板与渐变
 *
 * 唯一事实来源是 iOS 的 `ios/Possibility/Core/DesignSystem/Theme.swift`，
 * 它本身又与原型 CSS 的 `:root` 变量一一对应 —— 所以这里是「回到 CSS」，
 * 变量名与原型保持一致，改色只改这一个文件。
 *
 * ⚠️ 页面/组件的 wxss 里禁止写死颜色（十六进制或 rgba），一律从这里取。
 * `npm run lint:tokens` 会拦（对应 web 的 `web/scripts/check-design-tokens.mjs`）。
 * 只管颜色：字号与圆角在 iOS 那边本来就是各视图内联的数字（Theme.swift 里没有字阶），
 * 这里跟着走，不另造一套基准里不存在的体系。
 */

page,
.kaleido-root {
  /* ── 基础色（Theme.stage / paper / card / raised / ink / sub / faint / line）── */
  --stage: #05070d;
  --paper: #0a0c12;
  --card: #13161f;
  --raised: #1b1f2b;
  --ink: #f2f4f9;
  --sub: #98a0b3;
  --faint: #5a6172;
  --line: rgba(255, 255, 255, 0.08);

  /* ── 品牌色 ── */
  --blue: #5e96ff;
  --blue-deep: #2f63e8;
  --violet-soft: #8f7bff;
  --pink: #f06acd;
  --magenta: #e35cc1;
  --orange: #ff7a4d;
  --apricot: #ffb067;
  --teal: #3ed9a4;
  --lime: #d7f464;

  /* ── 渐变 ── */
  /* 极光渐变（Theme.aurora） */
  --aurora: linear-gradient(
    135deg,
    #5e96ff 0%,
    #8f7bff 40%,
    #e35cc1 75%,
    #ff7a4d 100%
  );
  /* 极光渐变 · 深（Theme.auroraDeep） */
  --aurora-deep: linear-gradient(
    135deg,
    #2f63e8 0%,
    #b03390 60%,
    #e8542f 100%
  );
  /* 主按钮渐变（Theme.buttonGradient） */
  --btn-g: linear-gradient(135deg, #6fa5ff, #2f63e8);

  /* 光球 / 万花筒的 conic 色环（Theme.orbConicColors）。
     ⚠️ Skyline 对 conic-gradient 的支持需由 W0-0 冒烟验证确认；
     不支持时 OrbView 退回 canvas 2d 绘制，本变量仍作为色标来源。 */
  --orb-conic: conic-gradient(
    from 0deg,
    #5e96ff 0%,
    #8f7bff 25%,
    #e35cc1 50%,
    #ff7a4d 75%,
    #5e96ff 100%
  );

  /* ── 旅人头像配色（Theme.hues，原型 HUES 0..4）── */
  --hue0-g: linear-gradient(135deg, #0f1f52 0%, #2e5edb 55%, #6fa5ff 100%);
  --hue0-accent: #3d6ef0;
  --hue1-g: linear-gradient(135deg, #3a1035 0%, #b03390 55%, #f06acd 100%);
  --hue1-accent: #c445a4;
  --hue2-g: linear-gradient(135deg, #0e2a22 0%, #1f8a66 60%, #8fd84b 100%);
  --hue2-accent: #2fa98c;
  --hue3-g: linear-gradient(135deg, #3a140c 0%, #d14a24 60%, #ff8a54 100%);
  --hue3-accent: #e85a34;
  --hue4-g: linear-gradient(135deg, #171243 0%, #4a3bd1 60%, #8f7bff 100%);
  --hue4-accent: #6e58e8;

  /* ── 卡面点缀色（Theme.cardAccents）──
     LLM 返回的颜色只当色相提示，一律吸附到这五档，否则一屏卡片会出现
     互不相干的随机彩虹色 —— 那正是「模型生成感」的来源之一。 */
  --accent-0: #5e96ff;
  --accent-1: #8f7bff;
  --accent-2: #e35cc1;
  --accent-3: #ffb067;
  --accent-4: #3ed9a4;

  /* 卡面点缀色的底衬与描边档（CardIconChip：12%/24% 常态，20%/50% 选中）。
     WXSS 没有 color-mix，透明档只能逐档写死；改点缀色时这 20 行要一起改。 */
  --accent-0-wash: rgba(94, 150, 255, 0.12);
  --accent-0-wash-on: rgba(94, 150, 255, 0.2);
  --accent-0-line: rgba(94, 150, 255, 0.24);
  --accent-0-line-on: rgba(94, 150, 255, 0.5);
  --accent-1-wash: rgba(143, 123, 255, 0.12);
  --accent-1-wash-on: rgba(143, 123, 255, 0.2);
  --accent-1-line: rgba(143, 123, 255, 0.24);
  --accent-1-line-on: rgba(143, 123, 255, 0.5);
  --accent-2-wash: rgba(227, 92, 193, 0.12);
  --accent-2-wash-on: rgba(227, 92, 193, 0.2);
  --accent-2-line: rgba(227, 92, 193, 0.24);
  --accent-2-line-on: rgba(227, 92, 193, 0.5);
  --accent-3-wash: rgba(255, 176, 103, 0.12);
  --accent-3-wash-on: rgba(255, 176, 103, 0.2);
  --accent-3-line: rgba(255, 176, 103, 0.24);
  --accent-3-line-on: rgba(255, 176, 103, 0.5);
  --accent-4-wash: rgba(62, 217, 164, 0.12);
  --accent-4-wash-on: rgba(62, 217, 164, 0.2);
  --accent-4-line: rgba(62, 217, 164, 0.24);
  --accent-4-line-on: rgba(62, 217, 164, 0.5);

  /* 卡面右上角的印章光晕（iOS `stampGlow = accent.opacity(0.17)`） */
  --accent-0-glow: rgba(94, 150, 255, 0.17);
  --accent-1-glow: rgba(143, 123, 255, 0.17);
  --accent-2-glow: rgba(227, 92, 193, 0.17);
  --accent-3-glow: rgba(255, 176, 103, 0.17);
  --accent-4-glow: rgba(62, 217, 164, 0.17);

  /* ── 圆角（Theme.Radius）── */
  --r-card: 22rpx;
  --r-sheet: 30rpx;
  --r-chip: 999rpx;

  /* ── 品牌色的透明档与浅色梯度 ──
     iOS 各 Feature 里 `Color(hex: 0x6FA5FF, alpha:)` 出现 25 次、
     `.white.opacity(0.045)` 5 次 —— 是复用的设计语言而非某个页面的私料，
     所以收在这里。页面需要「品牌色带透明」时一律从这取，不要自己写 rgba。 */
  --blue-line: rgba(111, 165, 255, 0.34); /* 强调描边（主路径卡 / 重试胶囊）*/
  --blue-line-soft: rgba(111, 165, 255, 0.2); /* 面板描边 */
  --blue-line-strong: rgba(111, 165, 255, 0.6); /* 选中态胶囊描边 */
  --blue-wash: rgba(94, 150, 255, 0.1); /* 极淡底色（重试胶囊）*/

  /* 「我添加的」——用户自己输入的关键词用绿色与系统推荐区分（DimensionSheet.sourceLegend）。
     色值与 --hue2-accent 相同，但语义不同：这里表达「来源是我」，不是旅人配色。 */
  --mine: #2fa98c;
  --mine-line: rgba(62, 217, 164, 0.6);
  --surface-ghost: rgba(255, 255, 255, 0.045); /* 次级路径卡底 */
  /* 浅色梯度：eyebrow → 链接 → 卡内标签，越大越浅 */
  --blue-100: #91b1ff;
  --blue-200: #9dbcff;
  --blue-300: #afc7ff;
  --blue-400: #b8cdff;

  /* ── 强调卡描边（三色同为 alpha 0.25，用色相区分卡片语义）── */
  --line-accent-blue: rgba(111, 165, 255, 0.25); /* hero 卡 */
  --line-accent-violet: rgba(169, 125, 255, 0.25); /* 「两股拉力」*/
  --line-accent-teal: rgba(62, 217, 164, 0.25); /* 「下一步的小验证」*/

  /* 长正文：比 --sub 亮、比 --ink 暗，用于需要连读数行的卡片正文 */
  --body-dim: #c6cdde;
  /* 渐变底/实色按钮上的文字（iOS 直接写 Color.white）*/
  --on-accent: #ffffff;
  /* 半透明白：spinner 轨道等「比 --line 明显、但仍是白纱」的地方 */
  --track: rgba(255, 255, 255, 0.3);
  /* 比 --line 重一档的描边（小圆钮 / 次级图标底的轮廓） */
  --hairline-strong: rgba(255, 255, 255, 0.18);
  /* 弹层遮罩（--stage 的 0.72）*/
  --scrim: rgba(5, 7, 13, 0.72);

  /* 品牌染色渐变（面板 / 主路径 / hero 卡） */
  --tint-panel: linear-gradient(
    135deg,
    rgba(94, 150, 255, 0.11) 0%,
    rgba(143, 123, 255, 0.055) 100%
  );
  --tint-primary: linear-gradient(
    135deg,
    rgba(62, 112, 232, 0.28) 0%,
    rgba(107, 85, 211, 0.18) 100%
  );
  --tint-hero: linear-gradient(
    135deg,
    rgba(64, 101, 203, 0.24) 0%,
    rgba(113, 73, 170, 0.12) 100%
  );
  /* 用户气泡（ChatView.bubbleBackground） */
  --user-bubble: linear-gradient(135deg, #3e77f2 0%, #2a50d6 100%);

  /* 右上角白色柔光 —— 叠在实色卡面上做出「有光源」的层次
     （iOS `DimensionSheet.toolBackground` 的 RadialGradient）。
     底色由数据给（各小工具自带 tint），这一层只负责打光。 */
  --gloss-tr: radial-gradient(
    circle at 100% 0%,
    rgba(255, 255, 255, 0.12) 0%,
    rgba(255, 255, 255, 0) 70%
  );

  /* ── 阴影（CardBackground）── */
  --shadow-card: 0 2rpx 8rpx rgba(0, 0, 0, 0.55);

  /* ── 数字形象舞台（PersonaCanvasView.PersonaStageView）──
     iOS 那边这几个值是写在视图里的内联色，Theme.swift 没有收录；但页面 wxss
     是零色值的，所以只能落在这里。命名带 stage- 前缀标明作用域：它们只服务
     首页的数字形象舞台，不是通用设计语言，别的页面不要取用。 */
  --stage-bg: linear-gradient(135deg, #080c1a 0%, #10162b 55%, #080b16 100%);
  --stage-glow-a: radial-gradient(
    circle at 50% 48%,
    rgba(83, 115, 255, 0.22) 0%,
    rgba(83, 115, 255, 0) 100%
  );
  --stage-glow-b: radial-gradient(
    circle at 30% 80%,
    rgba(227, 92, 193, 0.12) 0%,
    rgba(227, 92, 193, 0) 100%
  );
  /* 底部压暗，保证 caption 可读 */
  --stage-scrim: linear-gradient(
    to bottom,
    rgba(7, 10, 20, 0) 38%,
    rgba(7, 10, 20, 0.07) 62%,
    rgba(7, 9, 18, 0.88) 100%
  );
  --stage-badge-bg: rgba(7, 11, 24, 0.54);
  --stage-badge-line: rgba(198, 218, 255, 0.18);
  --stage-badge-ink: #dce8ff;
  /* inset 描边：集齐 3 张人生底牌时换成偏紫的高亮档 */
  --stage-inset: rgba(172, 201, 255, 0.12);
  --stage-inset-on: rgba(174, 174, 255, 0.22);

  /* ── 首页（HomeView / HomeCards）──
     同上：iOS 把这些写在各卡片视图里，Theme.swift 未收录。前缀标明作用域。 */

  /* AI 发问卡（HomeAskCard.askBackground） */
  --ask-bg: linear-gradient(135deg, #141a34 0%, #1a2350 50%, #10132a 100%);
  --ask-glow: radial-gradient(
    circle at 100% 0%,
    rgba(111, 165, 255, 0.35) 0%,
    rgba(111, 165, 255, 0) 100%
  );
  --ask-line: rgba(122, 158, 255, 0.3);
  --ask-box-bg: rgba(6, 8, 16, 0.45);
  --ask-box-line: rgba(255, 255, 255, 0.12);
  --ask-send-shadow: 0 12rpx 20rpx rgba(79, 125, 255, 0.6);
  --ask-clear-ink: #aeb7cc;
  /* eyebrow 左侧的小横杠（--blue-200 的 0.6） */
  --eyebrow-rule: rgba(157, 188, 255, 0.6);

  /* 熔岩灯光斑（AskGlowLayer 的三颗球）。
     iOS 用 blur(10/12/14) 把边缘化开；这里靠渐变本身的软收尾达到同样观感，
     不用 filter —— Skyline 不保证支持，而且这一层是纯装饰，不值得赌。 */
  --lava-1: radial-gradient(
    circle,
    rgba(111, 165, 255, 0.65) 0%,
    rgba(143, 123, 255, 0.28) 52%,
    rgba(143, 123, 255, 0) 72%
  );
  --lava-2: radial-gradient(
    circle,
    rgba(227, 92, 193, 0.42) 0%,
    rgba(143, 123, 255, 0.2) 55%,
    rgba(143, 123, 255, 0) 75%
  );
  --lava-3: radial-gradient(
    circle,
    rgba(255, 255, 255, 0.34) 0%,
    rgba(157, 188, 255, 0.16) 55%,
    rgba(157, 188, 255, 0) 72%
  );

  /* 话题胶囊与软标签的选中/未选中两态（HomeAskCard.softChip / askBox 的话题条） */
  --chip-on-bg: rgba(94, 150, 255, 0.14);
  --chip-on-line: rgba(94, 150, 255, 0.5);
  --chip-off-bg: rgba(255, 255, 255, 0.07);
  --chip-off-line: rgba(255, 255, 255, 0.1);
  --pill-topic-bg: rgba(94, 150, 255, 0.16);
  --pill-topic-line: rgba(94, 150, 255, 0.4);

  /* 语音日记卡（DiaryCard）：记过的日子填极光，今天套一圈虚线 */
  --day-filled: linear-gradient(135deg, #3e77f2 0%, #b03390 100%);
  --day-today-ring: rgba(94, 150, 255, 0.55);
  --diary-pill-bg: rgba(94, 150, 255, 0.12);

  /* 人生卡牌入口（LifeEntryButton） */
  --life-bg: linear-gradient(
    135deg,
    rgba(26, 35, 80, 0.6) 0%,
    rgba(43, 27, 45, 0.4) 100%
  );
  --life-line: rgba(143, 123, 255, 0.3);

  /* 画像卡（PortraitCard）：未填写的维度行用虚线框 + 极淡蓝底提示「这里还空着」 */
  --dim-todo-bg: rgba(94, 150, 255, 0.06);
  --dim-todo-line: rgba(94, 150, 255, 0.4);
  /* 人生底牌小卡的描边 */
  --card-glyph-line: rgba(174, 174, 255, 0.25);
  /* 引文左侧的竖线（--sub 的 0.34） */
  --quote-rule: rgba(152, 160, 179, 0.34);

  /* ── 旅人主页 / 付费墙（ProfileView / ProfilePanels / PaywallView）──
     同上：iOS 内联在各视图里，Theme.swift 未收录，前缀标明作用域。

     有三处刻意复用了既有 token 而不另造近义色 —— 色差都在 1% 以内，
     肉眼分不出，多一个近义色只会让「该取哪个」变成日常疑问：
     - iOS 正文 #C8CDDA / #C9CFDC / #C8CEDD → 统一用 --body-dim（#C6CDDE）
     - iOS 服务标签底 white 0.055        → 用 --surface-ghost（0.045）
     - iOS 成功勾底 #3ED9A4 0.14         → 用 --teal-wash（0.12） */

  --profile-bg: #090b12;
  /* 顶栏与 tabs 吸顶条：近乎不透明的纸色。
     iOS 底部付费栏用 .ultraThinMaterial 毛玻璃，小程序两种渲染器下
     backdrop-filter 都不保证，所以取实色 —— 观感差别只在滚动时的一层底纹。 */
  --profile-bar: rgba(10, 12, 18, 0.92);
  /* hero：斜向深蓝底 + 右上角蓝色泛光 */
  --profile-hero-bg: linear-gradient(135deg, #111625 0%, #0b0e17 100%);
  --profile-hero-glow: radial-gradient(
    circle at 100% 0%,
    rgba(94, 150, 255, 0.28) 0%,
    rgba(94, 150, 255, 0) 70%
  );
  /* 头像右下角在线点的描边：挖出 hero 底色，做出「浮在头像上」的缺口 */
  --profile-online-ring: #10131d;
  /* 「经历已验证」徽标 / 服务流程的步骤序号 */
  --badge-blue-bg: rgba(94, 150, 255, 0.13);
  --badge-blue-line: rgba(94, 150, 255, 0.26);
  --badge-blue-ink: #afc8ff;
  /* 旅人标签胶囊 */
  --profile-tag-bg: rgba(94, 150, 255, 0.11);
  --profile-tag-line: rgba(94, 150, 255, 0.2);
  --profile-tag-ink: #c6d7ff;
  /* 「她的故事」引文卡 */
  --story-quote-bg: linear-gradient(
    135deg,
    rgba(94, 150, 255, 0.15) 0%,
    rgba(143, 123, 255, 0.08) 100%
  );
  /* 小节说明标题（完整故事 · 最难的一关 / 轨迹说明） */
  --note-title-ink: #b9ccff;
  /* 时间线：节点圆点挖底 + 外圈紫环 + 竖线自上而下淡出 */
  --timeline-dot-ring: #0b0e17;
  --timeline-dot-halo: rgba(143, 123, 255, 0.5);
  --timeline-line: linear-gradient(
    to bottom,
    #8f7bff 0%,
    rgba(143, 123, 255, 0.08) 100%
  );
  /* 建议条目序号底 / 结账成功勾底 */
  --teal-wash: rgba(62, 217, 164, 0.12);
  /* 三档服务卡：底色区分品类，描边取同色相 0.28 */
  --svc-consult-bg: linear-gradient(135deg, #151c34 0%, #111327 100%);
  --svc-consult-line: rgba(111, 165, 255, 0.28);
  --svc-materials-bg: linear-gradient(135deg, #172820 0%, #101a17 100%);
  --svc-materials-line: rgba(62, 217, 164, 0.28);
  --svc-companion-bg: linear-gradient(135deg, #2b1b2d 0%, #17121f 100%);
  --svc-companion-line: rgba(227, 92, 193, 0.28);
  /* 主 CTA 投影（iOS PrimaryButton 与 PayBar 同一族） */
  --cta-shadow: 0 16rpx 28rpx rgba(79, 125, 255, 0.6);
  /* 结账页底色（iOS 的 presentationBackground） */
  --paywall-bg: #11141d;

  /* ── 人生实验室（iOS Features/Lab/）── */

  /* 表盘底：径向三段，中心略偏上（iOS RadialGradient center 0.5/0.42） */
  --dial-base: radial-gradient(
    circle at 50% 42%,
    #1e222e 0%,
    #161923 55%,
    #0f1118 100%
  );
  --dial-edge: rgba(255, 255, 255, 0.09);
  /* 指针把手：亮盘 + 内芯极光 */
  --dial-knob: #f2f4f9;
  --dial-knob-ring: rgba(255, 255, 255, 0.15);
  /* 指针杆自上而下淡出 */
  --dial-arm: linear-gradient(
    to bottom,
    rgba(111, 165, 255, 0.85) 0%,
    rgba(111, 165, 255, 0) 100%
  );
  /* 拖拽悬停时的虚线热区圈 */
  --dial-hot-line: rgba(111, 165, 255, 0.55);

  /* 选择卡：未选虚线描边，选中实线 + 渐变底 */
  --choice-bg: #151922;
  --choice-line: rgba(255, 255, 255, 0.2);
  --choice-line-on: rgba(111, 165, 255, 0.72);
  --choice-bg-on: linear-gradient(
    135deg,
    rgba(94, 150, 255, 0.26) 0%,
    rgba(143, 123, 255, 0.13) 100%
  );
  --choice-shadow-on: 0 16rpx 24rpx rgba(79, 125, 255, 0.5);
  /* 「写一张自己的卡」用品红一族，和模型生成的卡分开 */
  --choice-create-bg: #131720;
  --choice-create-line: rgba(255, 255, 255, 0.13);
  --choice-create-line-on: rgba(231, 132, 211, 0.82);
  --choice-create-bg-on: linear-gradient(
    135deg,
    rgba(227, 92, 193, 0.24) 0%,
    rgba(143, 123, 255, 0.14) 100%
  );

  /* 三种未来的分档配色（iOS ResultView TabSpec）：顺光 / 大概率 / 背光 */
  --sim-best-accent: #f06acd;
  --sim-best-bg: linear-gradient(135deg, #2c1533 0%, #1a1226 100%);
  --sim-likely-accent: #6fa5ff;
  --sim-likely-bg: linear-gradient(135deg, #152048 0%, #11142b 100%);
  --sim-worst-accent: #ff8a5e;
  --sim-worst-bg: linear-gradient(135deg, #33160e 0%, #1c0f0c 100%);
  /* 「最关键的条件」虚线框 */
  --sim-key-line: rgba(111, 165, 255, 0.45);
  --sim-key-bg: linear-gradient(
    135deg,
    rgba(94, 150, 255, 0.12) 0%,
    rgba(215, 244, 100, 0.08) 100%
  );
  /* 底线分析 / 底线测试面板的深空底 */
  --sim-panel-bg: #11151d;
  /* 推演遮罩：几乎不透明，只留一点底层轮廓 */
  --sim-overlay: rgba(8, 9, 15, 0.94);

  /* 选择卡：未选中的落影、印章光晕（自定义卡那张单列，iOS 用的是 0.15） */
  --choice-shadow: 0 6rpx 12rpx rgba(0, 0, 0, 0.5);
  --choice-create-glow: rgba(227, 92, 193, 0.15);
  --choice-create-shadow-on: 0 16rpx 24rpx rgba(215, 90, 194, 0.48);
  --choice-tick-create-g: linear-gradient(135deg, #e35cc1, #8f7bff);

  /* 输入面：问题编辑框与自定义卡编辑器共用 */
  --field-bg: rgba(6, 8, 16, 0.54);
  --field-line: rgba(255, 255, 255, 0.1);
  --field-bg-focus: rgba(6, 8, 16, 0.5);
  --field-line-focus: rgba(111, 165, 255, 0.4);

  --editor-bg: linear-gradient(
    135deg,
    rgba(94, 150, 255, 0.08) 0%,
    rgba(227, 92, 193, 0.055) 100%
  );
  --editor-line: rgba(143, 161, 255, 0.19);

  /* 手势提示条 */
  --hint-badge-bg: rgba(143, 123, 255, 0.1);
  --hint-badge-line: rgba(143, 123, 255, 0.17);
  --hint-badge-ink: #d9d0f5;
  --hint-ink: #b6bed0;
  --hint-dim: #5d6578;

  /* 生成中提示胶囊 */
  --cload-bg: rgba(94, 150, 255, 0.08);
  --cload-line: rgba(111, 165, 255, 0.22);

  /* 拖拽浮标 */
  --ghost-bg: rgba(22, 26, 38, 0.94);
  --ghost-line: rgba(111, 165, 255, 0.55);
  --ghost-shadow: 0 0 46rpx rgba(79, 125, 255, 0.35);

  /* ── 推演结果页（iOS ResultView）── */
  /* 顶栏用半透明底 + 模糊，压住下面滚动过去的内容（iOS .ultraThinMaterial） */
  --sim-bar-bg: rgba(16, 19, 28, 0.86);
  /* 三档结局的光斑：叠在 --sim-*-bg 之上，位置在右上角（iOS RadialGradient topTrailing） */
  --sim-best-glow: rgba(240, 106, 205, 0.4);
  --sim-likely-glow: rgba(111, 165, 255, 0.4);
  --sim-worst-glow: rgba(255, 138, 94, 0.4);
  --sim-best-line: rgba(240, 106, 205, 0.35);
  --sim-likely-line: rgba(111, 165, 255, 0.35);
  --sim-worst-line: rgba(255, 138, 94, 0.35);

  /* 底线压力测试 / 底线分析：两块面板共用一套「守得住 / 会击穿」的色语言 */
  --floor-accent: #ff9b77;
  --floor-line: rgba(255, 122, 77, 0.24);
  --floor-ok: #3ed9a4;
  --floor-ok-bg: rgba(62, 217, 164, 0.08);
  --floor-ok-line: rgba(62, 217, 164, 0.3);
  --floor-ok-wash: rgba(62, 217, 164, 0.12);
  --floor-ok-line-on: rgba(62, 217, 164, 0.55);
  --floor-bad: #ff8a5e;
  --floor-bad-bg: rgba(255, 122, 77, 0.08);
  --floor-bad-line: rgba(255, 122, 77, 0.3);
  --floor-bad-wash: rgba(255, 138, 94, 0.12);
  --floor-bad-line-on: rgba(255, 138, 94, 0.55);
  /* 未选中的按钮：比 --raised 更淡，让「还没答」和「答过了」一眼分开 */
  --floor-btn-bg: rgba(255, 255, 255, 0.05);
  --bottom-ok-line: rgba(62, 217, 164, 0.24);

  /* 旅人头像：压在色带上，靠半透明黑底压出层次，描边提亮轮廓 */
  --avatar-bg: rgba(8, 10, 18, 0.42);
  --avatar-line: rgba(255, 255, 255, 0.28);
  --avatar-ink: #ffffff;

  /* ── 万花筒社区（iOS Features/Community/）──
     同上：iOS 内联在各视图里，Theme.swift 未收录，前缀标明作用域。

     四处刻意复用既有 token 而不另造近义色（差值都在肉眼之下）：
     - 搜索框底 white 0.05         → --surface-ghost（0.045）
     - 放映开关描边 #5E96FF 0.45   → --chip-on-line（0.5）
     - 抽取页底色 #06080E          → --stage（#05070D）
     - 模式卡选中描边 #6FA5FF 0.7  → --choice-line-on（0.72）

     悬赏标签胶囊也没有自己的 token：底色正好是 --blue-wash、文字正好是
     --badge-blue-ink，两个都是精确相等。 */

  /* 悬赏 / 抽取的浮动主按钮：比 --cta-shadow 再抬高一档（iOS r18 y10 α.65） */
  --fab-shadow: 0 19rpx 35rpx rgba(79, 125, 255, 0.65);

  /* 放映模式底部说明（iOS #9AA4BC 0.62） */
  --watch-caption: rgba(154, 164, 188, 0.62);

  /* 抽取浮层：上下两颗极淡的光晕，把视线压向中间的万花筒 */
  --draw-glow-a: radial-gradient(
    circle at 50% 30%,
    rgba(94, 150, 255, 0.075) 0%,
    rgba(94, 150, 255, 0) 100%
  );
  --draw-glow-b: radial-gradient(
    circle at 50% 90%,
    rgba(227, 92, 193, 0.035) 0%,
    rgba(227, 92, 193, 0) 100%
  );
  /* 「类似 / 相反」模式卡选中态 */
  --draw-mode-bg-on: linear-gradient(
    135deg,
    rgba(94, 150, 255, 0.16) 0%,
    rgba(227, 92, 193, 0.1) 100%
  );
  /* 抽中的旅人卡：浮层里唯一的实体卡，落影比页面里的卡重得多 */
  --draw-card-shadow: 0 23rpx 58rpx rgba(0, 0, 0, 0.5);

  /* 悬赏详情的赏金卡：全站唯一的暖色实底卡，深棕字压在橙金渐变上 */
  --prize-g: linear-gradient(135deg, #ffc98a 0%, #ffb067 55%, #f08e4e 100%);
  --prize-ink: #2b1a08;
  --prize-ink-soft: rgba(43, 26, 8, 0.8);
  --prize-ink-faint: rgba(43, 26, 8, 0.75);
  --prize-shadow: 0 15rpx 27rpx rgba(255, 176, 103, 0.25);
  /* 名片已发送提示（底与描边复用底线测试那套「守得住」的绿） */
  --sent-ink: #8ee7c8;
}

/* ── 通用卡片样式（对应 iOS 的 .kaleidoCard() modifier）── */
.kaleido-card {
  background: var(--card);
  border-radius: var(--r-card);
  border: 1rpx solid var(--line);
  box-shadow: var(--shadow-card);
  overflow: hidden;
}

/* ── 标签胶囊（对应 iOS TagPill）── */
.tag-pill {
  display: inline-flex;
  align-items: center;
  padding: 4rpx 16rpx;
  border-radius: var(--r-chip);
  background: var(--raised);
  border: 1rpx solid var(--line);
  color: var(--sub);
  font-size: 20rpx;
}
