.page {
  min-height: 100vh;
  padding: 32rpx;
  box-sizing: border-box;
}

.placeholder {
  padding: 48rpx 32rpx;
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.placeholder__title {
  font-size: 34rpx;
  font-weight: 600;
  color: var(--ink);
}

.placeholder__hint {
  font-size: 24rpx;
  color: var(--sub);
}
