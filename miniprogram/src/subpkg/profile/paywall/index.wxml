<view class="page safe-bottom">
  <block wx:if="{{succeeded}}">
    <view class="ok">
      <view class="ok__mark">
        <text class="ok__glyph">✓</text>
      </view>
      <text class="ok__title">{{successTitle}}</text>
      <text class="ok__sub">{{successSub}}</text>
      <btn block bindtap="onClose">
        <text class="ok__cta">好的</text>
      </btn>
    </view>
  </block>

  <block wx:else>
    <view class="head safe-top">
      <text class="head__title">{{headTitle}}</text>
      <view class="head__close" hover-class="head__close--hover" bindtap="onClose">
        <text class="head__x">✕</text>
      </view>
    </view>

    <!-- 商品未确定前只有光球：这里宁可空着也不能先摆一个会变的金额 -->
    <view wx:if="{{!ready}}" class="loading">
      <orb size="140" halo="{{false}}" />
    </view>

    <view wx:else class="order">
      <view class="order__text">
        <text class="order__title">{{itemTitle}}</text>
        <text class="order__sub">{{itemSub}}</text>
      </view>
      <text class="order__price">¥{{priceText}}</text>
    </view>

    <block wx:if="{{ready}}">
      <text class="note">{{payNote}}</text>

      <btn block loading="{{processing}}" disabled="{{processing}}" bindtap="onPay">
        <text class="pay__label">{{actionTitle}}</text>
      </btn>
    </block>
  </block>
</view>
