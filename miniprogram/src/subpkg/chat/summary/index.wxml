<view class="summary">
  <!-- ── 顶栏 ── -->
  <view class="topbar safe-top">
    <view class="topbar__back" hover-class="topbar__back--hover" bindtap="onBack">
      <text class="topbar__icon">‹</text>
    </view>
    <view class="topbar__text">
      <text class="topbar__title">本次探索总结</text>
      <text class="topbar__sub">不是定论，是此刻更清楚的你</text>
    </view>
  </view>

  <scroll-view class="scroll" scroll-y enhanced show-scrollbar="{{false}}">
    <view class="scroll__inner">
      <!-- ── hero ── -->
      <view class="hero">
        <text class="hero__eyebrow">{{eyebrow}}</text>
        <text class="hero__question">{{question}}</text>
        <text class="hero__note">这份总结来自刚才的对话，只记录你此刻认可的理解，不替你下结论。</text>
      </view>

      <!-- ── 四张卡 ── -->
      <view
        wx:for="{{cards}}"
        wx:key="eyebrow"
        class="card {{item.accent ? 'card--' + item.accent : ''}}"
      >
        <text class="card__eyebrow">{{item.eyebrow}}</text>
        <text class="card__title">{{item.title}}</text>
        <text class="card__body">{{item.body}}</text>
      </view>

      <!-- 总结页里不再出现「先查看完整总结 →」——用户已经在总结页上了 -->
      <next-panel
        class="next-panel"
        show-summary-link="{{false}}"
        preferred-path="{{recommendedNextStep}}"
        matched-travelers="{{matchedTravelers}}"
        match-reasons="{{matchReasons}}"
        share-text="{{shareText}}"
        bind:golab="onGoLab"
        bind:gosimilar="onGoSimilar"
        bind:travelertap="onTravelerTap"
      />
    </view>
  </scroll-view>

  <view class="footer safe-bottom">
    <btn block bind:tap="onFinish">完成本次探索</btn>
  </view>
</view>
