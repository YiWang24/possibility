/* 探索对话 —— 对应 iOS ChatView。色值一律取 tokens.wxss 变量。 */

.chat {
  display: flex;
  flex-direction: column;
  height: 100vh;
  box-sizing: border-box;
  background: var(--paper);
}

/* ── 顶栏 ── */

.topbar {
  display: flex;
  align-items: center;
  gap: 26rpx;
  /* padding-top 归 .safe-top 管，这里不能写 padding 简写（见 app.wxss）*/
  padding-left: 44rpx;
  padding-right: 44rpx;
  padding-bottom: 24rpx;
  flex-shrink: 0;
  border-bottom: 1rpx solid var(--line);
}

.topbar__back,
.topbar__history {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 72rpx;
  height: 72rpx;
  flex-shrink: 0;
  border-radius: 50%;
  background: var(--raised);
  border: 1rpx solid var(--line);
}

.topbar__btn--hover {
  opacity: 0.7;
}

.topbar__icon {
  font-size: 34rpx;
  line-height: 1;
  color: var(--ink);
}

.topbar__text {
  flex: 1;
  min-width: 0;
}

.topbar__title {
  display: block;
  font-size: 32rpx;
  font-weight: 600;
  letter-spacing: 1.6rpx;
  color: var(--ink);
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.topbar__sub {
  display: block;
  margin-top: 4rpx;
  font-size: 22rpx;
  color: var(--faint);
}

/* ── 消息流 ── */

.stream {
  flex: 1;
  min-height: 0;
}

.stream__inner {
  padding: 24rpx 40rpx;
}

.row {
  display: flex;
  margin-top: 28rpx;
}

.row--user {
  justify-content: flex-end;
  padding-left: 80rpx;
}

.row--ai {
  justify-content: flex-start;
  padding-right: 80rpx;
}

.bubble {
  max-width: 600rpx;
  padding: 26rpx 32rpx;
  line-height: 1.65;
  /* 尖角朝发送方（iOS UnevenRoundedRectangle：20 / 6） */
  border-radius: 40rpx;
}

.bubble--user {
  background: var(--user-bubble);
  border-bottom-right-radius: 12rpx;
  color: var(--on-accent);
  font-size: 29rpx;
}

.bubble--ai {
  background: var(--card);
  border: 1rpx solid var(--line);
  border-bottom-left-radius: 12rpx;
  color: var(--ink);
  font-size: 28rpx;
}

.seg--bold {
  font-weight: 600;
}

/* ── 正在想 ── */

.thinking {
  display: flex;
  align-items: center;
  gap: 20rpx;
  margin-top: 32rpx;
}

.thinking__text {
  font-size: 24rpx;
  color: var(--faint);
}

/* ── 重新发送 ── */

.retry {
  display: inline-block;
  margin-top: 20rpx;
  padding: 18rpx 30rpx;
  border-radius: var(--r-chip);
  background: var(--blue-wash);
  border: 1rpx solid var(--blue-line);
}

.retry--hover {
  opacity: 0.7;
}

.retry__text {
  font-size: 25rpx;
  font-weight: 600;
  color: var(--blue-300);
}

/* ── 验证反馈 chips ── */

.chips {
  display: flex;
  gap: 18rpx;
  margin-top: 28rpx;
}

.chip {
  padding: 18rpx 32rpx;
  border-radius: var(--r-chip);
}

.chip--hover {
  opacity: 0.75;
}

.chip--primary {
  background: var(--btn-g);
}

.chip--ghost {
  background: var(--raised);
  border: 1rpx solid var(--line);
}

.chip__text {
  font-size: 25rpx;
  color: var(--sub);
}

.chip__text--primary {
  font-weight: 600;
  color: var(--on-accent);
}

.next-panel {
  display: block;
  margin-top: 28rpx;
}

/* 零高锚点：只用来给 scroll-into-view 定位，不占版面 */
.anchor {
  height: 16rpx;
}

/* ── 输入栏 ── */

.inputbar {
  display: flex;
  align-items: center;
  gap: 20rpx;
  flex-shrink: 0;
  /* padding-bottom 归 .safe-bottom 管（见 app.wxss）*/
  padding-top: 24rpx;
  padding-left: 36rpx;
  padding-right: 36rpx;
  border-top: 1rpx solid var(--line);
  background: var(--paper);
}

.inputbar__field {
  flex: 1;
  min-width: 0;
  height: 84rpx;
  padding: 0 36rpx;
  box-sizing: border-box;
  border-radius: var(--r-chip);
  background: var(--raised);
  border: 1rpx solid var(--line);
  font-size: 27rpx;
  color: var(--ink);
}

.inputbar__ph {
  color: var(--faint);
}

.inputbar__send {
  flex-shrink: 0;
  padding: 24rpx 44rpx;
  border-radius: var(--r-chip);
  background: var(--btn-g);
}

.inputbar__send--off {
  opacity: 0.45;
}

.inputbar__send-text {
  font-size: 26rpx;
  font-weight: 600;
  color: var(--on-accent);
}

/* ── 历史探索 ── */

.history {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
  padding-bottom: 24rpx;
}

.hrow {
  padding: 30rpx;
  border-radius: 36rpx;
  background: var(--card);
  border: 1rpx solid var(--line);
}

.hrow--hover {
  opacity: 0.75;
}

.hrow__head {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.hrow__ready {
  font-size: 18rpx;
  letter-spacing: 2rpx;
  color: var(--teal);
}

.hrow__time {
  margin-left: auto;
  font-size: 20rpx;
  color: var(--faint);
}

.hrow__summary {
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
  overflow: hidden;
  margin-top: 18rpx;
  font-size: 27rpx;
  font-weight: 600;
  line-height: 1.55;
  color: var(--ink);
}
