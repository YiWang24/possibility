# 复制为 supabase/functions/.env（本地 supabase functions serve 用，已被 .gitignore 忽略），
# 或在部署环境通过 Supabase Secrets 设置。不要把真实密钥提交到仓库。
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com

# 可按延迟/成本需求覆盖；未设置时使用代码内默认值。
# 三个场景统一走 flash（低延迟/低成本）；保留独立变量以便单场景灰度换模型。
DEEPSEEK_CHAT_MODEL=deepseek-v4-flash
DEEPSEEK_STRUCTURED_MODEL=deepseek-v4-flash
DEEPSEEK_DIARY_MODEL=deepseek-v4-flash

# Azure AI Speech Fast Transcription。密钥仅存在于 Edge Function Secrets，
# 禁止放入 Web 环境变量。Endpoint 使用 Speech 资源的 properties.endpoint。
AZURE_SPEECH_KEY=
AZURE_SPEECH_ENDPOINT=
AZURE_SPEECH_API_VERSION=2025-10-15
AZURE_SPEECH_LOCALES=zh-CN,en-US

# 可选：用于 Cron / 内部函数触发 diary-worker。留空时服务端复用 service-role secret。
DIARY_WORKER_SECRET=
DIARY_DAILY_ENTRY_LIMIT=30
