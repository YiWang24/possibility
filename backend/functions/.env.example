# 复制为 supabase/.env.local 或在部署环境通过 Supabase Secrets 设置。
# 不要把真实密钥提交到仓库。
ANTHROPIC_API_KEY=
ANTHROPIC_BASE_URL=https://llm-center.modelbest.cn/llm

# 可按延迟/成本需求覆盖；未设置时使用技术设计文档中的质量默认值。
ANTHROPIC_CHAT_MODEL=claude-sonnet-5
ANTHROPIC_STRUCTURED_MODEL=claude-sonnet-5
ANTHROPIC_DIARY_MODEL=claude-sonnet-5
