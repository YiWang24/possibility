.DS_Store

# 环境变量文件（含敏感信息，禁止提交）
# 用通配覆盖所有变体：.env.production / .env.development / .env.keys / web/.env.* 等。
# 逐个枚举必然漏（web/.gitignore 只挡 .env*.local，web/.env.production 曾无人看管）。
# 只放行模板；确需入库的其他 .env 变体用 git add -f 显式放行。
.env*
!**/.env.example

# 签名凭据与私钥（本仓库公开：一旦提交即等同泄露，且必须轮换才能挽回）
# Apple：Sign in with Apple / APNs 的 AuthKey_*.p8、证书、描述文件
*.p8
*.p12
*.cer
*.certSigningRequest
*.mobileprovision
GoogleService-Info.plist
# Android：签名密钥库、Firebase 配置
*.jks
*.keystore
keystore.properties
google-services.json
# 通用私钥与凭据文件
*.pem
*.key
id_rsa*
.netrc

# Supabase / 后端
supabase/.branches
supabase/.temp
supabase/functions/.env
node_modules/
coverage/

# iOS 本地配置（各自填写 Supabase 值，不进仓库；提交模板 Config.xcconfig.example）
# Base.xcconfig 入库并 #include? 本文件，见 ios/Config/
ios/Config/Config.xcconfig

# Xcode 产物
*.xcuserstate
xcuserdata/
DerivedData/
.build/
*.hmap
*.moved-aside
*.xcscmblueprint
*.xccheckout
*.xcresult/
.swiftpm/
# 例外提醒：ios/Possibility.xcodeproj/project.xcworkspace/xcshareddata/swiftpm/Package.resolved
# 必须入库 —— 它锁住 SPM 依赖版本，CI 靠它复现同一套依赖。上面的 .swiftpm/ 只命中
# 同名目录，命不中它；别顺手加 swiftpm/ 这种更宽的规则。

# 发布产物：scripts/ios-testflight.sh 的归档与 ipa 落在 ios/build/。
# 两个理由必须挡住：单个 dSYM 就有 50MB+；且 Xcode 写的 export/Packaging.log 里
# 含 altool 用 .p8 现签的 App Store Connect bearer token（曾误入库一次，见 PR 说明）。
ios/build/
*.xcarchive/
*.ipa
*.dSYM/
*.dSYM.zip

# 签名材料：一律不入库。分发凭据走 Doppler（ASC_KEY_P8 等），证书私钥留在本机钥匙串。
*.p8
*.p12
*.pfx
*.pem
*.cer
*.certSigningRequest
*.mobileprovision
*.provisionprofile
*.keystore
*.jks

# Android / Gradle
android/.gradle/
android/.idea/
android/.kotlin/
android/local.properties
android/**/build/
*.iml

# Doppler 本地覆盖（doppler.yaml 入库，个人 fallback 不入）
.doppler/

# Claude/Agent 本地 worktree 与工具产物（不进仓库）
.claude/
.qoder/
.gstack/
